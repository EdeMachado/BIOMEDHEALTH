# Ambiente demonstrativo - dados ficticios
# Nao inserir segredos reais no repositorio.

VITE_APP_ENV=development
VITE_APP_NAME=BIOMED HEALTH
VITE_DEMO_MODE=true

# Supabase (preencher localmente quando criado o projeto)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Flags de feature
VITE_ENABLE_MAGIC_LINK=true
VITE_ENABLE_SUPABASE_AUTH=false

# SUP-C04.1 — modos por modulo clinico (`mock` | `supabase`).
# Precedencia: flag especifica valida > VITE_ENABLE_SUPABASE_AUTH > default mock (quando global ausente/false).
# Valor invalido: erro deterministico (sem selecao silenciosa de adapter).
# CLINICAL_RECORD = ficha clinica C02; NAO cobre a pagina demo /clinica/registros.
# VITE_CLINICAL_AGENDA_REPOSITORY_MODE=
# VITE_CLINICAL_PORTFOLIO_REPOSITORY_MODE=
# VITE_CLINICAL_RECORD_REPOSITORY_MODE=
# VITE_CLINICAL_CARE_PLAN_REPOSITORY_MODE=

# SUP-D01-C — repository coletivo (campanhas/planos) `mock` | `supabase`.
# Precedencia: VITE_COLLECTIVE_REPOSITORY_MODE valida > VITE_ENABLE_SUPABASE_AUTH > default mock.
# Valor invalido: erro deterministico (fail-closed; sem fallback runtime para mock).
# Escritas multi-tabela (selected_units / audiencias) bloqueadas sem RPC autorizada (fora do D01-C).
# VITE_COLLECTIVE_REPOSITORY_MODE=

# SUP-C04.2a — observabilidade clinica + politica de fallback (deny-by-default) — entregue (PR #14).
# Defaults de politica no codigo: enableTransientFallback=false e enableMockDataFallback=false.
# Auth/RLS/validacao/integridade e writes nunca fazem fallback; producao nunca faz fallback.
# Instrumentacao sanitizada (sem PHI/tokens); sink console estruturado (silencioso em MODE=test).
# PostgreSQL/PostgREST 42501 nos repositories clinicos esta normalizado (PR #15) como
# CROSS_TENANT_DATA / authorization / transient:false e e inelegivel a qualquer fallback de dados.
# SUP-C04.2b (switch de dados mock em runtime) foi ENCERRADA SEM IMPLEMENTACAO por bloqueio
# arquitetural; nao ha ativacao planejada destas flags. Nao ligar fallback clinico no baseline.
# Continuidade: PROJECT_MASTER_HANDOFF.md.
