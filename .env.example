# Ambiente demonstrativo - dados ficticios
# Nao inserir segredos reais no repositorio.

VITE_APP_ENV=development
VITE_APP_NAME=BIOMED HEALTH
VITE_DEMO_MODE=true

# Supabase (preencher localmente quando criado o projeto)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Flags de feature
VITE_ENABLE_MAGIC_LINK=true
VITE_ENABLE_SUPABASE_AUTH=false

# SUP-C04.1 — modos por modulo clinico (`mock` | `supabase`).
# Precedencia: flag especifica valida > VITE_ENABLE_SUPABASE_AUTH > default mock (quando global ausente/false).
# Valor invalido: erro deterministico (sem selecao silenciosa de adapter).
# CLINICAL_RECORD = ficha clinica C02; NAO cobre a pagina demo /clinica/registros.
# VITE_CLINICAL_AGENDA_REPOSITORY_MODE=
# VITE_CLINICAL_PORTFOLIO_REPOSITORY_MODE=
# VITE_CLINICAL_RECORD_REPOSITORY_MODE=
# VITE_CLINICAL_CARE_PLAN_REPOSITORY_MODE=

# SUP-C04.2 — observabilidade clinica + politica de fallback (deny-by-default).
# Fallback de dados mock permanece desligado (enableTransientFallback/enableMockDataFallback = false).
# Auth/RLS/validacao/integridade e writes nunca fazem fallback.
# Instrumentacao sanitizada (sem PHI/tokens); sink console estruturado (silencioso em MODE=test).
# Troca efetiva de backend (mock) reservada a C04.2b apos normalizar mapeamento PostgreSQL 42501
# entre repositories clinicos (hoje nao uniforme: CROSS_TENANT_DATA vs PLAN_CLOSED/RECORD_CONCLUDED).
